# SafarDesk — UNIFIED .env (one-build-many-tenants)
# All agencies in ONE file. App resolves tenant by hostname at runtime.
# Build ONCE: npm run build
# Deploy same dist/ to all: firebase deploy --only hosting --project <id>
#
# Copy this to .env and fill in the API keys.

# ============ ABU SULTAN ============
VITE_TENANT_ABUSULTAN_API_KEY=
VITE_TENANT_ABUSULTAN_AUTH_DOMAIN=safardesk-abusultan.firebaseapp.com
VITE_TENANT_ABUSULTAN_PROJECT_ID=safardesk-abusultan
VITE_TENANT_ABUSULTAN_STORAGE_BUCKET=safardesk-abusultan.firebasestorage.app
VITE_TENANT_ABUSULTAN_SENDER_ID=1035503425935
VITE_TENANT_ABUSULTAN_APP_ID=1:1035503425935:web:5e55e4c66aa2829fed13fa
VITE_TENANT_ABUSULTAN_HOSTNAME=safardesk-abusultan.web.app
VITE_TENANT_ABUSULTAN_KEY=abusultan
VITE_TENANT_ABUSULTAN_COMPANY_NAME=Abu Sultan Travel & Tours

