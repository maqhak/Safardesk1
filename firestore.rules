rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    function isOwner() {
      return isSignedIn() && userDoc().role == 'owner';
    }

    function isStaff() {
      return isSignedIn() && userDoc().role == 'staff';
    }

    function isAgent() {
      return isSignedIn() && userDoc().role == 'agent';
    }

    function myAgentId() {
      return isSignedIn() ? userDoc().agentId : null;
    }

    function hasPerm(module, action) {
      return isOwner() || (isStaff() && userDoc().permissions[module][action] == true);
    }

    // Fix #27: resolve whether a ledger account belongs to the calling agent.
    // Accounts live in two legacy collections; check both safely.
    function accountBelongsToAgent(accId) {
      let p1 = /databases/$(database)/documents/ledger_accounts/$(accId);
      let p2 = /databases/$(database)/documents/ledgerAccounts/$(accId);
      return (exists(p1) && (get(p1).data.linkedId == myAgentId() || get(p1).data.linkedAgentId == myAgentId()))
          || (exists(p2) && (get(p2).data.linkedId == myAgentId() || get(p2).data.linkedAgentId == myAgentId()));
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner() || isStaff());
      // Bootstrap: a signed-in user may create their OWN doc (first user becomes Owner via app logic).
      // Owners may create docs for others. Public signup stays disabled in Firebase Auth settings.
      allow create: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isOwner() || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isOwner();
    }

    // --- Masters (Agents, Vendors, Hotels, Airlines, Banks, Vehicles, Customers) ---
    match /agents/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /vendors/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /hotels/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /airlines/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /banks/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /vehicles/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /customers/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Visas', 'create');
    }

    // --- Visas, Visa Imports, Distributions, Invoices, Requests ---
    match /visas/{id} {
      allow read: if isOwner() || hasPerm('Visas', 'view') || (isAgent() && resource.data.agentId == myAgentId());
      allow write: if isOwner() || hasPerm('Visas', 'create');
    }

    match /visa_imports/{id} {
      allow read, write: if isOwner() || hasPerm('Visas', 'create');
    }

    match /visa_distributions/{id} {
      allow read, write: if isOwner() || hasPerm('Visas', 'create');
    }

    match /visa_invoices/{id} {
      allow read: if isOwner() || hasPerm('Visas', 'view') || (isAgent() && resource.data.agentId == myAgentId());
      allow write: if isOwner() || hasPerm('Visas', 'create');
    }

    // Fix #24/#27: agent-submitted visa applications
    match /visaRequests/{id} {
      allow read: if isOwner() || hasPerm('Visas', 'view') || (isAgent() && resource.data.agentId == myAgentId());
      allow create: if isOwner() || hasPerm('Visas', 'create') || (isAgent() && request.resource.data.agentId == myAgentId());
      allow update, delete: if isOwner() || hasPerm('Visas', 'create');
    }

    // --- Vouchers ---
    // Agents may create vouchers for themselves only, and never with charges
    // (hotel/transport charges are entered by Owner/Staff).
    match /vouchers/{id} {
      allow read: if isOwner() || hasPerm('Vouchers', 'view') || (isAgent() && resource.data.agentId == myAgentId());
      allow create: if isOwner() || hasPerm('Vouchers', 'create')
        || (isAgent() && request.resource.data.agentId == myAgentId()
            && (!request.resource.data.keys().hasAny(['charges']) || request.resource.data.charges.size() == 0));
      allow update: if isOwner() || hasPerm('Vouchers', 'edit');
      allow delete: if isOwner();
    }

    // --- Tickets ---
    // Fix #27: TicketDoc carries buyerType/buyerId (not agentId) — isolate on those.
    match /tickets/{id} {
      allow read: if isOwner() || hasPerm('Tickets', 'view')
        || (isAgent() && resource.data.buyerType == 'agent' && resource.data.buyerId == myAgentId());
      allow create: if isOwner() || hasPerm('Tickets', 'create')
        || (isAgent() && request.resource.data.buyerType == 'agent' && request.resource.data.buyerId == myAgentId());
      allow update, delete: if isOwner() || hasPerm('Tickets', 'edit');
    }

    // --- Ledger Accounts (two legacy collections, same rules) ---
    match /ledger_accounts/{id} {
      allow read: if isOwner() || hasPerm('Accounts', 'view')
        || (isAgent() && (resource.data.linkedId == myAgentId() || resource.data.linkedAgentId == myAgentId()));
      allow write: if isOwner() || hasPerm('Accounts', 'create');
    }

    match /ledgerAccounts/{id} {
      allow read: if isOwner() || hasPerm('Accounts', 'view')
        || (isAgent() && (resource.data.linkedId == myAgentId() || resource.data.linkedAgentId == myAgentId()));
      allow write: if isOwner() || hasPerm('Accounts', 'create');
    }

    // --- Ledger Entries, Payments, Journal Vouchers ---
    // Fix #27: agent reads only entries posted to their own ledger account.
    match /ledger_entries/{id} {
      allow read: if isOwner() || hasPerm('Accounts', 'view')
        || (isAgent() && accountBelongsToAgent(resource.data.accountId));
      allow write: if isOwner() || hasPerm('Accounts', 'create');
    }

    // Fix #30: PaymentDoc carries agentId (stamped at creation) — authorize only matching agents.
    match /payments/{id} {
      allow read: if isOwner() || hasPerm('Accounts', 'view')
        || (isAgent() && resource.data.agentId == myAgentId());
      allow write: if isOwner() || hasPerm('Accounts', 'create');
    }

    match /journal_vouchers/{id} {
      allow read: if isOwner() || hasPerm('Accounts', 'view');
      allow write: if isOwner() || hasPerm('Accounts', 'create');
    }

    match /accounts_invoices/{id} {
      allow read: if isOwner() || hasPerm('Accounts', 'view');
      allow write: if isOwner() || hasPerm('Accounts', 'create');
    }

    // --- Exchange Rates & Settings ---
    // Fix #27: the real collection is `exchangeRates` (was mismatched).
    match /exchangeRates/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('Masters', 'edit');
    }

    match /settings/company {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /settings/integrations {
      allow read, write: if isOwner();
    }

    // --- Audit Log (Append-only; real collection is `auditLog`) ---
    match /auditLog/{id} {
      allow create: if isSignedIn();
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}
